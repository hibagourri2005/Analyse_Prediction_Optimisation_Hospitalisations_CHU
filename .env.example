# Copiez ce fichier en ".env" à la racine du projet puis renseignez vos valeurs.
# Le fichier .env n'est jamais envoyé sur GitHub (voir .gitignore).

# --- Base de données MySQL (entrepôt chu_dwh) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chu_dwh
DB_USER=root
DB_PASSWORD=votre_mot_de_passe_mysql

# --- Backend (FastAPI) ---
# Clé de signature des tokens JWT : générez-en une avec
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=remplacez_par_une_longue_cle_aleatoire
# Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
